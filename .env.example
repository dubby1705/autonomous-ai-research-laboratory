# AARL — Autonomous AI Research Laboratory
# Copy this file to `.env` and fill in your own values. NEVER commit .env.

# Groq API key (required for LLM planning/analysis stages)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Groq model (optional; defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile